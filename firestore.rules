rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Subject app pushes discovery events. Write-only from his side:
    // he can create entries but can never read the log back.
    match /log/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['t','r','s','at'])
                    && request.resource.data.t is string
                    && request.resource.data.t.size() < 40;
      allow read, update, delete: if request.auth != null;
    }

    // Sightings pushed from the ops console. Subject reads; operators write.
    match /alerts/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Operator-only. The subject's app never touches these.
    match /tasks/{doc}       { allow read, write: if request.auth != null; }
    match /suggestions/{doc} { allow read, write: if request.auth != null; }

    match /{document=**} { allow read, write: if false; }
  }
}
