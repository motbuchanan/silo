rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /log/{doc}         { allow read, write: if true; }
    match /alerts/{doc}      { allow read, write: if true; }
    match /tasks/{doc}       { allow read, write: if true; }
    match /suggestions/{doc} { allow read, write: if true; }
    match /{document=**}     { allow read, write: if false; }
  }
}
